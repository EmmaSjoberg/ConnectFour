<UserControl x:Class="ConnectFour.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}">

        <StackPanel Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <Grid Width="220"
                  Height="150"
                  Margin="0,0,0,35">

                <Ellipse Width="100"
                         Height="100"
                         Fill="{StaticResource PlayerOneBrush}"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"/>

                <Ellipse Width="100"
                         Height="100"
                         Fill="{StaticResource PlayerTwoBrush}"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"/>

                <Ellipse Width="43"
                         Height="43"
                         Fill="{StaticResource BoardBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Text="Connect Four"
                       FontSize="43"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Margin="0,0,0,16"/>

            <TextBlock Text="Get four in a row to win."
                       TextAlignment="Center"
                       FontSize="15"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,0,0,36"/>

            <Button Content="Play"
                    Command="{Binding StartGameCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="230"
                    HorizontalAlignment="Center"/>

            <Border Background="{StaticResource SoftSurfaceBrush}"
                    CornerRadius="16"
                    Padding="18,10"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0">

                <StackPanel Orientation="Horizontal">

                    <Ellipse Width="10"
                             Height="10"
                             Fill="{StaticResource PlayerOneBrush}"
                             Margin="0,0,9,0"/>

                    <TextBlock Text="2 Players"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>

