<UserControl x:Class="ConnectFour.Views.EndView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="48,35">
            <TextBlock Text="Connect Four"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryTextBrush}"/>
        </Grid>

        <StackPanel Grid.Row="1"
                    Width="490"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- Illustration -->
            <Grid Width="220"
                  Height="150"
                  Margin="0,0,0,35">

                <Ellipse Width="105"
                         Height="105"
                         Fill="{StaticResource BoardBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>

                <Ellipse Width="76"
                         Height="76"
                         Fill="{StaticResource PlayerOneBrush}"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"/>

                <Ellipse Width="76"
                         Height="76"
                         Fill="{StaticResource PlayerTwoBrush}"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"/>
            </Grid>

            <TextBlock Text="{Binding ResultTitle}"
                       FontSize="44"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Margin="0,0,0,36"/>

            <Button Content="Play Again"
                    Command="{Binding PlayAgainCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="230"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12"/>

            <Button Content="Main Menu"
                    Command="{Binding BackToMenuCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="230"
                    HorizontalAlignment="Center"/>

        </StackPanel>
    </Grid>
</UserControl>
